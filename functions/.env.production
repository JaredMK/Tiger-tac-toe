# Production (firebase deploy --project production): never gated.
TTC_ENV=production
# App Check: set to enforce once the page carries a reCAPTCHA Enterprise key (src/env.js appCheckKey) and the console shows tokens flowing.
TTC_APPCHECK=
# The alert keys from Secret Manager (TWILIO_SID TWILIO_TOKEN TWILIO_FROM RESEND_KEY EMAIL_FROM): set to on once they are set and the deploy's account may bind them (Secret Manager Admin).
TTC_SECRETS=
