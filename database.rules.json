{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      ".indexOn": [
        "created"
      ],
      "$code": {
        ".validate": "$code.matches(/^[ABCDEFGHJKLMNPQRSTUVWXYZ]{5}$/)",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() == auth.uid && newData.child('players').child(newData.child('setup/hostSide').val()).child('uid').val() == auth.uid) || data.child('players/X/uid').val() == auth.uid || data.child('players/O/uid').val() == auth.uid || (!newData.exists() && data.child('created').val() < now - 86400000))",
        "players": {
          "$side": {
            ".write": "auth != null && $side.matches(/^[XO]$/) && !data.exists() && newData.child('uid').val() == auth.uid && root.child('rooms').child($code).child('status').val() == 'lobby'"
          }
        },
        "setup": {
          "games": {
            "$type": {
              ".validate": "newData.isBoolean() && (newData.val() == false || auth.token.admin === true || (root.child('releases').child($type).exists() ? root.child('releases').child($type).val() === true : $type.matches(/^(ttt|c4|bs|wordle|hangman|hex|hilo|snakes|memory|candy|bump|coins|pig|hunt|mastermind|bj|bus|rl|dice|hexapawn)$/)))"
            }
          }
        }
      }
    },
    "releases": {
      ".read": true,
      "$type": {
        ".write": "auth != null && auth.token.admin === true",
        ".validate": "$type.matches(/^[a-z0-9]{2,16}$/) && newData.isBoolean()"
      }
    },
    "presence": {
      "$code": {
        ".read": "auth != null",
        "$side": {
          ".write": "auth != null && (root.child('rooms').child($code).child('players').child($side).child('uid').val() == auth.uid || !root.child('rooms').child($code).exists())"
        }
      }
    },
    "users": {
      ".read": "auth != null"
    },
    "usernames": {
      ".read": "auth != null"
    },
    "leaderboard": {
      ".read": "auth != null",
      ".indexOn": [
        "rating"
      ]
    },
    "history": {
      "$uid": {
        ".read": "auth != null",
        ".indexOn": [
          "date"
        ]
      }
    },
    "games": {
      ".indexOn": [
        "dl",
        "pub/ended"
      ],
      "$id": {
        "pub": {
          ".read": "auth != null && (data.child('players/X/uid').val() === auth.uid || data.child('players/O/uid').val() === auth.uid)"
        }
      }
    },
    "gpresence": {
      "$id": {
        ".read": "auth != null && (root.child('games').child($id).child('pub/players/X/uid').val() === auth.uid || root.child('games').child($id).child('pub/players/O/uid').val() === auth.uid)",
        "$side": {
          ".write": "auth != null && $side.matches(/^[XO]$/) && root.child('games').child($id).child('pub/players').child($side).child('uid').val() === auth.uid"
        }
      }
    },
    "reacts": {
      "$key": {
        ".validate": "$key.matches(/^[-\\w]{5,40}$/)",
        ".read": "auth != null && (root.child('rooms').child($key).child('players/X/uid').val() === auth.uid || root.child('rooms').child($key).child('players/O/uid').val() === auth.uid || root.child('games').child($key).child('pub/players/X/uid').val() === auth.uid || root.child('games').child($key).child('pub/players/O/uid').val() === auth.uid)",
        ".write": "auth != null && !newData.exists() && !root.child('rooms').child($key).exists() && !root.child('games').child($key).exists()",
        "$side": {
          ".write": "auth != null && $side.matches(/^[XO]$/) && (root.child('rooms').child($key).child('players').child($side).child('uid').val() === auth.uid || root.child('games').child($key).child('pub/players').child($side).child('uid').val() === auth.uid) && (!data.exists() || data.child('t').val() <= now - 2000)",
          ".validate": "newData.hasChildren(['e', 't'])",
          "e": {
            ".validate": "newData.isNumber() && (newData.val() == 0 || newData.val() == 1 || newData.val() == 2 || newData.val() == 3 || newData.val() == 4 || newData.val() == 5)"
          },
          "t": {
            ".validate": "newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "features": {
      ".read": true,
      "findMatch": {
        ".write": "auth != null && auth.token.admin === true",
        ".validate": "newData.isBoolean()"
      },
      "$other": {
        ".validate": false
      }
    },
    "active": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "stats": {
      ".read": "auth != null && auth.token.admin === true"
    },
    "statsSeen": {
      "match": {
        ".indexOn": [
          "t0"
        ]
      }
    },
    "localStats": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "localHistory": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": [
          "date"
        ]
      }
    },
    "review": {
      ".read": "auth != null && auth.token.admin === true"
    },
    "admin": {
      "config": {
        ".read": "auth != null && auth.token.admin === true",
        ".write": "auth != null && auth.token.admin === true"
      },
      "secretsSet": {
        ".read": "auth != null && auth.token.admin === true",
        ".write": "auth != null && auth.token.admin === true"
      },
      "secrets": {
        "$key": {
          ".write": "auth != null && auth.token.admin === true",
          ".validate": "$key.matches(/^(twilioSid|twilioToken|twilioFrom|resendKey|emailFrom)$/) && newData.isString() && newData.val().length <= 300"
        }
      }
    },
    "bots": {
      ".read": "auth != null && auth.token.admin === true"
    },
    "botStats": {
      ".read": "auth != null && auth.token.admin === true"
    },
    "botGames": {
      ".indexOn": [
        "live"
      ]
    },
    "alertLog": {
      ".read": "auth != null && auth.token.admin === true",
      ".indexOn": [
        "at"
      ]
    },
    "alertStats": {
      ".read": "auth != null && auth.token.admin === true"
    },
    "lastSeen": {
      ".read": "auth != null && auth.token.admin === true"
    },
    "devices": {
      ".read": "auth != null && auth.token.admin === true"
    },
    "devlog": {
      ".read": "auth != null && auth.token.admin === true"
    },
    "config": {
      ".read": true,
      "bulls": {
        ".write": "auth != null && auth.token.admin === true",
        "board": {
          ".validate": "newData.isNumber() && newData.val() >= 4 && newData.val() <= 30"
        },
        "bull": {
          ".validate": "newData.isNumber() && newData.val() >= 0.5 && newData.val() <= 12 && newData.val() < newData.parent().child('board').val()"
        },
        "sweep": {
          ".validate": "newData.isNumber() && newData.val() >= 400 && newData.val() <= 5000"
        },
        "ramp": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 2"
        },
        "$other": {
          ".validate": false
        }
      },
      "wheels": {
        ".write": "auth != null && auth.token.admin === true",
        "target": {
          ".validate": "newData.isNumber() && newData.val() >= 6 && newData.val() <= 60"
        },
        "high": {
          "a": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
          },
          "pa": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99"
          },
          "b": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30 && (newData.val() > 0 || newData.parent().child('a').val() > 0)"
          },
          "$other": {
            ".validate": false
          }
        },
        "mid": {
          "a": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
          },
          "pa": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99"
          },
          "b": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30 && (newData.val() > 0 || newData.parent().child('a').val() > 0)"
          },
          "$other": {
            ".validate": false
          }
        },
        "low": {
          "a": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
          },
          "pa": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99"
          },
          "b": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30 && (newData.val() > 0 || newData.parent().child('a').val() > 0)"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      },
      "run": {
        "dash": {
          ".write": "auth != null && auth.token.admin === true",
          "target": {
            ".validate": "newData.isNumber() && newData.val() >= 200 && newData.val() <= 5000"
          },
          "v0": {
            ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 30"
          },
          "ramp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
          },
          "gapMin": {
            ".validate": "newData.isNumber() && newData.val() >= 8 && newData.val() <= 200"
          },
          "gapMax": {
            ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 400"
          },
          "mix": {
            "$kind": {
              ".validate": "$kind.matches(/^[a-z]{2,10}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "lane": {
          ".write": "auth != null && auth.token.admin === true",
          "target": {
            ".validate": "newData.isNumber() && newData.val() >= 200 && newData.val() <= 5000"
          },
          "v0": {
            ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 30"
          },
          "ramp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
          },
          "gapMin": {
            ".validate": "newData.isNumber() && newData.val() >= 8 && newData.val() <= 200"
          },
          "gapMax": {
            ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 400"
          },
          "mix": {
            "$kind": {
              ".validate": "$kind.matches(/^[a-z]{2,10}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "flap": {
          ".write": "auth != null && auth.token.admin === true",
          "target": {
            ".validate": "newData.isNumber() && newData.val() >= 200 && newData.val() <= 5000"
          },
          "v0": {
            ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 30"
          },
          "ramp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
          },
          "gapMin": {
            ".validate": "newData.isNumber() && newData.val() >= 8 && newData.val() <= 200"
          },
          "gapMax": {
            ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 400"
          },
          "mix": {
            "$kind": {
              ".validate": "$kind.matches(/^[a-z]{2,10}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "chopper": {
          ".write": "auth != null && auth.token.admin === true",
          "target": {
            ".validate": "newData.isNumber() && newData.val() >= 200 && newData.val() <= 5000"
          },
          "v0": {
            ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 30"
          },
          "ramp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
          },
          "gapMin": {
            ".validate": "newData.isNumber() && newData.val() >= 8 && newData.val() <= 200"
          },
          "gapMax": {
            ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 400"
          },
          "mix": {
            "$kind": {
              ".validate": "$kind.matches(/^[a-z]{2,10}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
