{
  "name": "tic-tac-chaos",
  "private": true,
  "description": "Tic Tac Chaos: a 3x3 board where every square is a mini-game",
  "scripts": {
    "test": "node --test \"tests/{games,shared,core,server}/*.test.js\" tests/page.test.js tests/ui/*.test.mjs",
    "sim": "node scripts/sim.js",
    "test:emulators": "node scripts/sync-functions.js && firebase emulators:exec --only auth,database,functions --project demo-tic-tac-chaos \"node --test --test-concurrency=1 --test-force-exit tests/emulator/server.test.js\"",
    "tune-ai": "node scripts/tune-ai.js",
    "share-images": "node scripts/make-share-images.js",
    "app-icons": "node scripts/make-app-icons.js",
    "app-shots": "node scripts/app-screenshots.js",
    "deploy:staging": "node scripts/deploy-staging.js",
    "release": "node scripts/release.js",
    "export:help": "node scripts/help-text.js export",
    "import:help": "node scripts/help-text.js import",
    "check:envs": "node scripts/check-envs.js",
    "build:app": "node scripts/build-app.js",
    "check:headers": "node scripts/check-headers.js"
  },
  "devDependencies": {
    "firebase": "11.10.0",
    "matter-js": "^0.20.0"
  }
}
